#!/bin/sh

# Description: File preview
#
# Dependencies:
#
# Usage:
#   This script is executed for each preview. Its output is displayed in the preview pane.
#   You can customize file types and their preview methods within the 'case' block.
#   NOTE: Do not use interactive commands to produce output.
#
# Shell: POSIX compliant
#
# Author: Shi Yanling


if [ "$2" = 'tui' ]; then
	sffpipe=$1
	[ -p "$sffpipe" ] && printf "#%s" "$0" >"$sffpipe"
	exit 0
fi

archivepl="${0%/*}/archive"
_path=$SFF_PV_PATH
_lines=$1
_cols=$2
_mime=$(file -bL --mime-type "$_path")

case "$_mime" in
text/*|application/json) echo ""
	head -n $_lines "$_path" | tr -d '\r' | expand -t 4
	;;
application/*-tar|application/*-compressed*|application/*[!+]zip*|application/zip|\
application/x-xz|application/vnd.rar|application/x-iso9660-image) "$archivepl" "$_path"
	;;
inode/directory) printf "  -- directory -- (%s files)\n" \
		$(find -L "$_path" -mindepth 1 -maxdepth 1 -printf '.' 2>/dev/null | wc -c)
	ls -1Ap "$_path"
	;;
*) printf "  -- %s --\n" "$_mime"
	;;
esac
